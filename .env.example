# NEXORA PLAY — Environment Variables Configuration

# Server Port
PORT=3000

# Environment Mode
NODE_ENV=development

# Admin Authorization Secret (For /api/admin/stats)
ADMIN_SECRET=nexora_admin_secret_2026

# PostgreSQL Database Connection String (Optional for managed DB)
DATABASE_URL=postgresql://user:password@localhost:5432/nexoraplay?schema=public

# Frontend Public Server WebSocket URL (If frontend is static host, point to persistent server)
NEXORA_SERVER_URL=http://localhost:3000
